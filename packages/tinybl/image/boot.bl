; boot.bl: the mezzanine and the manual, evaluated in the root of every new
; image. Each form is written in the language over the core and library
; natives, and each carries a doc that man shows.

; rooted first, so the rest can use it: a function or op from here finds
; names in the root, not in whoever called it

(def rooted (fn [obj]
  (set (slot obj (quote >>parent)) >>root-scope)
  obj))
(rooted rooted)

(def when (rooted (op
  (if (eval (at >>message 1) >>sender)
    (eval (to-record (concat [do] (rest (rest >>message)))) >>sender)))))

(def unless (rooted (op
  (if (eval (at >>message 1) >>sender)
    nil
    (eval (to-record (concat [do] (rest (rest >>message)))) >>sender)))))

(def and (rooted (op
  (def forms (rest >>message))
  (def i 0)
  (def last (quote true))
  (while (if last (lt i (len forms)))
    (set last (eval (at forms i) >>sender))
    (set i (add i 1)))
  last)))

(def or (rooted (op
  (def forms (rest >>message))
  (def i 0)
  (def found nil)
  (while (if found nil (lt i (len forms)))
    (set found (eval (at forms i) >>sender))
    (set i (add i 1)))
  found)))

(def cond (rooted (op
  (def clauses (rest >>message))
  (def i 0)
  (def found nil)
  (def answer nil)
  (while (if found nil (lt i (len clauses)))
    (def clause (at clauses i))
    (if (if (eq (first clause) (quote else)) (quote true) (eval (first clause) >>sender))
      (do
        (set found (quote true))
        (set answer (eval (to-record (concat [do] (rest clause))) >>sender))))
    (set i (add i 1)))
  answer)))

(def each (rooted (fn [items f]
  (def i 0)
  (while (lt i (len items))
    (f (at items i))
    (set i (add i 1)))
  items)))

(def map (rooted (fn [items f]
  (def out [])
  (def i 0)
  (while (lt i (len items))
    (set out (append out (f (at items i))))
    (set i (add i 1)))
  out)))

(def filter (rooted (fn [items f]
  (def out [])
  (def i 0)
  (while (lt i (len items))
    (def x (at items i))
    (if (f x) (set out (append out x)))
    (set i (add i 1)))
  out)))

(def inc (rooted (op
  (def r (at >>message 1))
  (def by (if (gt (len >>message) 2) (eval (at >>message 2) >>sender) 1))
  (eval (record (quote set) r (record (quote add) (record (quote get) r) by)) >>sender))))

(def dec (rooted (op
  (def r (at >>message 1))
  (def by (if (gt (len >>message) 2) (eval (at >>message 2) >>sender) 1))
  (eval (record (quote set) r (record (quote sub) (record (quote get) r) by)) >>sender))))

(def defn (rooted (op
  (def name (at >>message 1))
  (def forms (rest (rest >>message)))
  (def doc nil)
  (when (eq (kind (first forms)) (quote text))
    (set doc (first forms))
    (set forms (rest forms)))
  (def made (eval (to-record (concat [fn] forms)) >>sender))
  (when doc (set (layer made doc) (record (quote doc) doc)))
  (eval (record (quote def) name (record (quote quote) made)) >>sender)
  made)))

(def let (rooted (op
  (def bindings (at >>message 1))
  (eval
    (to-record (concat
      (list (to-record (concat [fn] (list (keys bindings)) (rest (rest >>message)))))
      (vals bindings)))
    >>sender))))

(def apply (rooted (fn [f items]
  (eval (to-record (concat
    (list (record (quote quote) f))
    (map items (fn [x] (record (quote quote) x)))))))))

; docs for the mezzanine

(document rooted {
  usage: "(rooted OBJ)"
  summary: "OBJ, its >>parent now the root, so a function or op finds names in the root rather than in whoever calls it."
  see: [fn op make]})

(document when {
  usage: "(when TEST FORM …)"
  summary: "Each FORM in turn when TEST isn't nil, answering the last, and nil otherwise."
  see: [unless if cond]})

(document unless {
  usage: "(unless TEST FORM …)"
  summary: "Each FORM in turn when TEST is nil, answering the last, and nil otherwise."
  see: [when if]})

(document and {
  usage: "(and X …)"
  summary: "Each X in turn until one is nil, answering the last evaluated, or true for none."
  see: [or not]})

(document or {
  usage: "(or X …)"
  summary: "Each X in turn until one isn't nil, answering it, or nil."
  see: [and not]})

(document cond {
  usage: "(cond [TEST FORM …] …)"
  summary: "The forms of the first clause whose TEST isn't nil, answering the last. A TEST of else always holds."
  see: [if when]})

(document each {
  usage: "(each ITEMS F)"
  summary: "F called with each member of ITEMS in turn, answering ITEMS."
  see: [map filter while]})

(document map {
  usage: "(map ITEMS F)"
  summary: "A list of what F answers for each member of ITEMS."
  see: [each filter apply]})

(document filter {
  usage: "(filter ITEMS F)"
  summary: "A list of the members of ITEMS for which F doesn't answer nil."
  see: [each map]})

(document inc {
  usage: "(inc REF BY?)"
  summary: "The number in the place REF names, raised by BY or 1 and put back. REF is any reference: a name, a path, (at …)."
  see: [dec set get]})

(document dec {
  usage: "(dec REF BY?)"
  summary: "The number in the place REF names, lowered by BY or 1 and put back."
  see: [inc set get]})

(document defn {
  usage: "(defn NAME DOC? [PARAM …] FORM …)"
  summary: "NAME, in this scope, now holds a function, carrying DOC when there is one."
  see: [fn def document]})

(document let {
  usage: "(let {NAME: EXPR …} FORM …)"
  summary: "The forms evaluated in a scope where each NAME holds what its EXPR evaluates to here."
  see: [def fn]})

(document apply {
  usage: "(apply F ITEMS)"
  summary: "What F answers called with the members of ITEMS as its arguments, unevaluated."
  see: [map fn]})

; the manual: topics man finds by name

(def manual (make nil {
  objects: (make nil {})
  send: (make nil {})
  places: (make nil {})
  prototypes: (make nil {})
  image: (make nil {})
  documenting: (make nil {})}))

(document manual {
  usage: "the manual"
  summary: "Topics for man: objects, send, places, prototypes, image and documenting."
  body: "(man) lists every documented name in the root and these topics.
(man TOPIC) shows one, and (apropos WORD) searches every doc."})

(document [manual objects] {
  usage: "objects and layers"
  summary: "An object is a node carrying layers, one of them its identity."
  body: "Everything here is a value or an object. An object is a node that
carries layers: an Identity, which gives it an id once it has a place in
the image, and any others, such as slots, a function, a native, a cell or
a doc. (make PROTO {NAME: EXPR …}) makes one with slots.

(layers X) answers how X's layers are written and (layer X HEAD) one of
them. Both are places, so (set (layer x doc) (quote (doc \"…\"))) edits an
object as it runs. (describe X) answers X's id, layers, slot names and
parent.

Written down an object is (object ID {LAYER …}), and a value holding an
object names it as (object ID)."
  see: [make layers layer describe]})

(document [manual send] {
  usage: "send and references"
  summary: "Every evaluation is a message sent to an object."
  body: "(>>send MSG REF) sends MSG, unevaluated, to what the reference REF
names. Evaluating a symbol sends it to the scope, which answers with its
slot or passes it to its >>parent, and the root ends every chain. A record
headed by a symbol is sent the same way, and the object in the slot of
that name receives it. ([OBJ NAME] ARG …) sends (NAME ARG …) to OBJ.

The references every image starts with are a NAME, a path [A B …],
(id ID), (native NAME) and (quote V). Any other record names a place
through its head, a scheme: at, slot, layer, layers and ref are in the
root, and a scheme is any object answering (>>resolve FORM)."
  see: [>>send ref get set]})

(document [manual places] {
  usage: "places and generalized reference"
  summary: "A reference names a place, which answers (>>get) and (>>put V)."
  body: "(set REF EXPR) puts into the place REF names and (get REF) reads it.
Places nest: (set (at (at m (quote a)) 1) 9) builds the inner list anew,
then the dict holding it, and puts the dict back where m is. (ref REF)
answers the place itself, an object to pass around. An object of your own
is a place when it answers (>>get) and (>>put V). inc and dec take any
reference."
  see: [set get ref at slot inc]})

(document [manual prototypes] {
  usage: "prototypes and self"
  summary: "An object delegates to its >>parent, and a function runs for its receiver."
  body: "(make PROTO {…}) makes an object whose >>parent is PROTO. A message
an object doesn't understand goes to its parent with self kept, so a
function found in a prototype runs with the receiver as self and sees the
receiver's slots.

A call's own slots are its params, >>self, >>sender and >>message, and
past them whatever self holds. A function made inside a call keeps that
call as its >>parent, so it sees the call's names. (set [OBJ >>parent] P)
changes a prototype while the image runs, and rooted makes a function see
the root's names rather than its caller's."
  see: [make fn op rooted]})

(document [manual image] {
  usage: "the image and its history"
  summary: "Everything reachable from the root is the image, and each change to it is said as an event."
  body: "An object gets an id when it enters the image, by being put into an
object already there. What happens to the image is said as events:
(created ID FORMS), (defined ID NAME NEW), (changed ID NAME OLD NEW),
(removed ID NAME OLD), (layered ID FORM) and (unlayered ID FORM). A
history keeps them as a log, a saved image is a snapshot of the root, and
loading reads the snapshot and then the log after it. (trace on) prints
each message as it is sent."
  see: [trace id id-of describe]})

(document [manual documenting] {
  usage: "documenting your own objects"
  summary: "A doc is a layer, put on any object with document."
  body: "(document REF DOC) puts a doc on the object REF names, and man shows
it from then on. A doc is a text or a dict. A text whose first line is a
form, as in \"(greet NAME)\\nSays hello.\", has that line as its usage and
the rest as its summary, and any other text is all summary. A dict may
hold usage, summary and body texts, and see, a list of names.

defn takes a doc text after its name. A doc is written with its object,
so it is saved and loaded with the image."
  see: [document defn man apropos]})

(document >>root-scope {
  usage: "the root"
  summary: "The image's root. Every name here is found from anywhere, and (man) lists them."
  see: [man apropos manual]})
