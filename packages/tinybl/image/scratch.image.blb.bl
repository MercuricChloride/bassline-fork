(image {at: 46 root: 0x586490BD8CF624272FBF2D8D41EE7083 objects: {0x0039DE194A283AB10A1924505EBC8464: {(doc "(text X)\nX as text: a text or symbol as it reads, anything else in text syntax.") (native text)} 0x02DC68D534C06B38CAB8C0904B589020: {(doc "(man NAME?)\nPrints the page for what NAME names, and the manual's topic of that\nname, or with no NAME every documented name and the topics.") (native man)} 0x052264810426027508A3818D34F9F496: {(doc {see: [>>send ref get set] body: "(>>send MSG REF) sends MSG, unevaluated, to what the reference REF\nnames. Evaluating a symbol sends it to the scope, which answers with its\nslot or passes it to its >>parent, and the root ends every chain. A record\nheaded by a symbol is sent the same way, and the object in the slot of\nthat name receives it. ([OBJ NAME] ARG …) sends (NAME ARG …) to OBJ.\n\nThe references every image starts with are a NAME, a path [A B …],\n(id ID), (native NAME) and (quote V). Any other record names a place\nthrough its head, a scheme: at, slot, layer, layers and ref are in the\nroot, and a scheme is any object answering (>>resolve FORM)." usage: "send and references" summary: "Every evaluation is a message sent to an object."}) (slots {:})} 0x053B1409B36719F53DB75D6284ECF83F: {(doc "(if TEST THEN ELSE?)\nTHEN when TEST isn't nil, otherwise ELSE or nil. nil is the only false.") (native if)} 0x056BE9EF43D7C9A0766A0D1BDF78D1F5: {(doc "(add N …)\nThe sum of the numbers, 0 for none.") (native add)} 0x05E731065E840A276BA00563204A0D7C: {(doc "(not X)\nThe symbol true when X is nil, and nil otherwise. nil is the only false.") (native not)} 0x07C0A40D4F773330F3DF5B5406BCEC80: {(doc "(rest FRAME)\nA list of a list's or record's members after the first.") (native rest)} 0x0914FC36FC46FCE133AE894B3FB0BC0E: {(op (def r (at >>message 1)) (def by (if (gt (len >>message) 2) (eval (at >>message 2) >>sender) 1)) (eval (record (quote set) r (record (quote add) (record (quote get) r) by)) >>sender)) (doc {see: [dec set get] usage: "(inc REF BY?)" summary: "The number in the place REF names, raised by BY or 1 and put back. REF is any reference: a name, a path, (at …)."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x0B849D81D1A697BFEFCCB94089D44E8F: {(doc "(>>send MSG REF)\nMSG, unevaluated, sent to what REF names, which is then self.") (native >>send)} 0x0D116B1A49BD0A334D45CFAFBA83A48D: {(doc "(append FRAME X …)\nFRAME with the values added: at the end of a list or record, as members\nof a set.") (native append)} 0x0F4EEE581D7F23FB3E6762FBFA7C84FF: {(doc "(quote V)\nV as written, unevaluated.") (native quote)} 0x1143907A396F0BCEB195649442FBCCF4: {(doc "(fn [PARAM …] FORM …)\nA function. Called, it evaluates each argument where the call is, binds\nit to a param, and answers its last form, evaluated in a scope below\nself, or below the call it was made in.") (native fn)} 0x115AE9445A07C32C15965638352F0D5F: {(doc "(div N M)\nN divided by M, rounded toward zero. Dividing by 0 refuses.") (native div)} 0x1947A29C5E86D424190E65920721E0A0: {(doc "(print X …)\nPrints the values on one line, texts as they read, and answers nil.") (native print)} 0x19F3AFAF0E552659399B75E7C937F2C9: {(doc {see: [document defn man apropos] body: "(document REF DOC) puts a doc on the object REF names, and man shows\nit from then on. A doc is a text or a dict. A text whose first line is a\nform, as in \"(greet NAME)\\nSays hello.\", has that line as its usage and\nthe rest as its summary, and any other text is all summary. A dict may\nhold usage, summary and body texts, and see, a list of names.\n\ndefn takes a doc text after its name. A doc is written with its object,\nso it is saved and loaded with the image." usage: "documenting your own objects" summary: "A doc is a layer, put on any object with document."}) (slots {:})} 0x1F0D2EB65149F7ED4709FC483D5EADD1: {(doc "(def NAME EXPR)\nNAME, in this scope, now holds what EXPR evaluates to.") (native def)} 0x2320DC885FD006DD69E7166482F66CB2: {(doc "(le A B)\nA when it comes before B or equals it, and nil otherwise.") (native le)} 0x27773D202356A431D0CD26CC44EE70EA: {(doc "(mod N M)\nWhat is left of N after dividing by M, with N's sign. M of 0 refuses.") (native mod)} 0x29EB5C41FFD9F9DE745C10E0D0D4375B: {(op (def clauses (rest >>message)) (def i 0) (def found nil) (def answer nil) (while (if found nil (lt i (len clauses))) (def clause (at clauses i)) (if (if (eq (first clause) (quote else)) (quote true) (eval (first clause) >>sender)) (do (set found (quote true)) (set answer (eval (to-record (concat [do] (rest clause))) >>sender)))) (set i (add i 1))) answer) (doc {see: [if when] usage: "(cond [TEST FORM …] …)" summary: "The forms of the first clause whose TEST isn't nil, answering the last. A TEST of else always holds."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x2DC9FA8C346F0082845F953021EE0C01: {(doc "(apropos WORD)\nPrints each name and topic whose name or doc holds WORD, a symbol or\ntext, in any case.") (native apropos)} 0x2FD3C0796112A240879CCA33A5CAC71A: {(doc "(quit)\nEnds the session, after a snapshot.") (native quit)} 0x3004BD2DFBE05BC84161B91D12EA4FA9: {(doc "(layer OBJ HEAD)\nHow OBJ's layer HEAD is written, or nil. As a reference, putting a form\nreads it onto OBJ in place of that layer, and putting nil takes it off.") (native layer) (resolver layer)} 0x329584DEE049DC2FE6B691DABEA6B385: {(doc "(while TEST FORM …)\nThe forms in turn for as long as TEST isn't nil, answering the last\nvalue they gave, or nil.") (native while)} 0x372A74CFCFEDB0A59FE31362B78A8483: {(doc "(entries FROM? TO?)\nThe log's entries numbered FROM through TO, all of them by default.") (native entries)} 0x3E29013938D885D769A6E52E7ECB1226: {(doc "(op FORM …)\nLike fn, but nothing is evaluated for it: the message is >>message and\nthe scope it came from is >>sender.") (native op)} 0x3EB89CC3CE8B5C9A4D0BF66D97559ED0: {(doc "(sub N M …)\nN less each M, or N negated when it stands alone.") (native sub)} 0x40F6482C3E62968DD819780E9CFD8C5E: {(doc "(kind X)\nX's kind as a symbol: nil, number, text, symbol, bytes, list, record,\ndict or set, and object for an object.") (native kind)} 0x4198FC4BF177EF8A6A0E892B7AC97A7D: {(doc "(first FRAME)\nA list's or record's first member, nil when it has none.") (native first)} 0x4291C4175D7ED067A822CB4088350B0C: {(doc "(to-record LIST)\nA record of LIST's members, so code can be built as a list and run.") (native to-record)} 0x43C68F2E612282A984CF752F2FDC07D8: {(doc "(document REF DOC)\nPuts the doc DOC, a text or a dict, on the object REF names. man shows\nit from then on.") (native document)} 0x44EE88903B945A11DE4A223359785063: {(op (if (eval (at >>message 1) >>sender) nil (eval (to-record (concat [do] (rest (rest >>message)))) >>sender))) (doc {see: [when if] usage: "(unless TEST FORM …)" summary: "Each FORM in turn when TEST is nil, answering the last, and nil otherwise."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x455C82CB8585E2A5E38883E6856B69A3: {(doc "(record HEAD X …)\nA record of the values, HEAD first.") (native record)} 0x462238699594CDB20BC79546ADFC5C0A: {(doc "(at FRAME KEY)\nFRAME's member at KEY: a list's or record's by position, a dict's by key.\nAs a reference, a put builds the frame anew and puts it back.") (native at) (resolver at)} 0x47FBA5316852E108BD4964D3DCB27CC9: {(doc "(save)\nWrites a snapshot of the image, so it opens without replaying the log.") (native save)} 0x48276E1B14DC0D4B475B75EB0AD93C78: {(fn [obj] (set (slot obj (quote >>parent)) >>root-scope) obj) (doc {see: [fn op make] usage: "(rooted OBJ)" summary: "OBJ, its >>parent now the root, so a function or op finds names in the root rather than in whoever calls it."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x4AB58B2EC8C252FC9A5E7C3DDF08A82C: {(fn [f items] (eval (to-record (concat (list (record (quote quote) f)) (map items (fn [x] (record (quote quote) x))))))) (doc {see: [map fn] usage: "(apply F ITEMS)" summary: "What F answers called with the members of ITEMS as its arguments, unevaluated."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x4B2BB246158F99424FAC80EC75F84977: {(doc "(describe X)\nA dict of X's id, the layers it carries as written apart from its\nslots, its slot names and its parent.") (native describe)} 0x502966DE80EB5D6785A8037C1713709D: {(doc "(lt A B)\nA when it comes before B, and nil otherwise. Numbers compare by size,\nanything else in CE order.") (native lt)} 0x531B655ECE96E9070592AF7E4D67F85F: {(fn [items f] (def out []) (def i 0) (while (lt i (len items)) (def x (at items i)) (if (f x) (set out (append out x))) (set i (add i 1))) out) (doc {see: [each map] usage: "(filter ITEMS F)" summary: "A list of the members of ITEMS for which F doesn't answer nil."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x586490BD8CF624272FBF2D8D41EE7083: {(doc {see: [man apropos manual] usage: "the root" summary: "The image's root. Every name here is found from anywhere, and (man) lists them."}) (slots {at: (object 0x462238699594CDB20BC79546ADFC5C0A) do: (object 0xA06CD045BA7F849ABF07AA4B73CAEF41) eq: (object 0xFCB13901ED9DACD3E00179C129F91132) fn: (object 0x1143907A396F0BCEB195649442FBCCF4) ge: (object 0xB4850FE0A0D337912389F76007FDF2E5) gt: (object 0x670A48778B0ED14F51C622DDF8D9D538) id: (object 0xA4F67F3B300EF0D15007645B86E423ED) if: (object 0x053B1409B36719F53DB75D6284ECF83F) le: (object 0x2320DC885FD006DD69E7166482F66CB2) lt: (object 0x502966DE80EB5D6785A8037C1713709D) ne: (object 0xF423E40A9D706A9DC7B909910E6B2860) op: (object 0x3E29013938D885D769A6E52E7ECB1226) or: (object 0x97260368338222994D054B8C8B62BBC6) add: (object 0x056BE9EF43D7C9A0766A0D1BDF78D1F5) and: (object 0xF93067E7C226C0C0729064F6D52F8324) dec: (object 0x686E7A9793E0779A34FCC8144607CFC1) def: (object 0x1F0D2EB65149F7ED4709FC483D5EADD1) div: (object 0x115AE9445A07C32C15965638352F0D5F) get: (object 0xE5C117B2453CDCD9F6DE3C7EFD8AB8F2) has: (object 