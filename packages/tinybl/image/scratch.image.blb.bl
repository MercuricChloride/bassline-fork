ct 0x0D116B1A49BD0A334D45CFAFBA83A48D) concat: (object 0xF0F1B5B19AF85659153EE45D981BB4DE) filter: (object 0x531B655ECE96E9070592AF7E4D67F85F) layers: (object 0xE29F43BEA690A34C8345F96DC2DFD0F5) manual: (object 0x969965A95BCDE2D8316B76C682DADE7F) native: (object 0x6A5F1C1F88C42881AA975B8389F20320) record: (object 0x455C82CB8585E2A5E38883E6856B69A3) rooted: (object 0x48276E1B14DC0D4B475B75EB0AD93C78) unless: (object 0x44EE88903B945A11DE4A223359785063) apropos: (object 0x2DC9FA8C346F0082845F953021EE0C01) entries: (object 0x372A74CFCFEDB0A59FE31362B78A8483) history: (object 0x69A06CE701EB15954DEDFC61150B07B6) describe: (object 0x4B2BB246158F99424FAC80EC75F84977) document: (object 0x43C68F2E612282A984CF752F2FDC07D8) run-file: (object 0xC90ED9D6CB8076C25BEBCB1FA05DA245) parent-of: (object 0xF7B63FD7AD5A7CBE44CB7CDA040D4FB7) to-record: (object 0x4291C4175D7ED067A822CB4088350B0C) workspace: (object 0xF432F5B93E059C8FC05CA8D0697B6EFF) >>root-scope: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x59DE9CB7F9ECD94A56B08E4AFEE38375: {(doc "(len X)\nHow many members a frame has, a dict counting its keys, how many\ncharacters a text or symbol has, how many bytes bytes have.") (native len)} 0x5F75E2C044187E0A2274FF7B6FB6E0D8: {(doc "(undo N)\nUndoes log entry N and every entry it caused, last first, by appending\n(undid N) and the changes that reverse them. Nothing is erased, so\nundoing an (undid N) does it again. Answers the (undid N) entry's number.") (native undo)} 0x60ADE11BE9C6E64C0BE6AB7177D84521: {(doc "(id-of OBJ)\nOBJ's id, or nil when it has no place in the image yet.") (native id-of)} 0x670A48778B0ED14F51C622DDF8D9D538: {(doc "(gt A B)\nA when it comes after B, and nil otherwise.") (native gt)} 0x686E7A9793E0779A34FCC8144607CFC1: {(op (def r (at >>message 1)) (def by (if (gt (len >>message) 2) (eval (at >>message 2) >>sender) 1)) (eval (record (quote set) r (record (quote sub) (record (quote get) r) by)) >>sender)) (doc {see: [inc set get] usage: "(dec REF BY?)" summary: "The number in the place REF names, lowered by BY or 1 and put back."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x69A06CE701EB15954DEDFC61150B07B6: {(doc "(history OBJ NAME?)\nThe log entries that touch OBJ, or only its slot NAME, oldest first.") (native history)} 0x6A5F1C1F88C42881AA975B8389F20320: {(doc "(native NAME)\nThe host's native NAME, an error when the host has none.") (native native)} 0x799B07B878E8168F4AAE24AA8EB44804: {(doc "(ref REF)\nThe place REF names, as an object receiving (>>get) and (>>put V).") (native ref)} 0x7A0670305B122ED5F59172026764180D: {(doc "(slot OBJ NAME)\nWhat OBJ answers NAME with, its own slot or one it delegates to.") (native slot) (resolver slot)} 0x7AF7C3AA50C6BD31909A539FBAD28E74: {(doc "(entry N)\nThe log's entry N.") (native entry)} 0x7C51DFB9D184179B8A7049355B2917EB: {(doc {see: [make layers layer describe] body: "Everything here is a value or an object. An object is a node that\ncarries layers: an Identity, which gives it an id once it has a place in\nthe image, and any others, such as slots, a function, a native, a cell or\na doc. (make PROTO {NAME: EXPR …}) makes one with slots.\n\n(layers X) answers how X's layers are written and (layer X HEAD) one of\nthem. Both are places, so (set (layer x doc) (quote (doc \"…\"))) edits an\nobject as it runs. (describe X) answers X's id, layers, slot names and\nparent.\n\nWritten down an object is (object ID {LAYER …}), and a value holding an\nobject names it as (object ID)." usage: "objects and layers" summary: "An object is a node carrying layers, one of them its identity."}) (slots {:})} 0x7D82047C8E49599E0903766759A65B0B: {(fn [items f] (def out []) (def i 0) (while (lt i (len items)) (set out (append out (f (at items i)))) (set i (add i 1))) out) (doc {see: [each filter apply] usage: "(map ITEMS F)" summary: "A list of what F answers for each member of ITEMS."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x890FDB279904442B231A7F8A13A3F4FB: {(doc "(mul N …)\nThe product of the numbers, 1 for none.") (native mul)} 0x969965A95BCDE2D8316B76C682DADE7F: {(doc {body: "(man) lists every documented name in the root and these topics.\n(man TOPIC) shows one, and (apropos WORD) searches every doc." usage: "the manual" summary: "Topics for man: objects, send, places, prototypes, image and documenting."}) (slots {send: (object 0x052264810426027508A3818D34F9F496) image: (object 0xB665C957FDEDDEF285CDA534938C605A) places: (object 0xDF3C32048198D296BE723B587DCE6BAF) objects: (object 0x7C51DFB9D184179B8A7049355B2917EB) prototypes: (object 0x98244FC702390B285F39A54A8D4271E0) documenting: (object 0x19F3AFAF0E552659399B75E7C937F2C9)})} 0x97260368338222994D054B8C8B62BBC6: {(op (def forms (rest >>message)) (def i 0) (def found nil) (while (if found nil (lt i (len forms))) (set found (eval (at forms i) >>sender)) (set i (add i 1))) found) (doc {see: [and not] usage: "(or X …)" summary: "Each X in turn until one isn't nil, answering it, or nil."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0x98244FC702390B285F39A54A8D4271E0: {(doc {see: [make fn op rooted] body: "(make PROTO {…}) makes an object whose >>parent is PROTO. A message\nan object doesn't understand goes to its parent with self kept, so a\nfunction found in a prototype runs with the receiver as self and sees the\nreceiver's slots.\n\nA call's own slots are its params, >>self, >>sender and >>message, and\npast them whatever self holds. A function made inside a call keeps that\ncall as its >>parent, so it sees the call's names. (set [OBJ >>parent] P)\nchanges a prototype while the image runs, and rooted makes a function see\nthe root's names rather than its caller's." usage: "prototypes and self" summary: "An object delegates to its >>parent, and a function runs for its receiver."}) (slots {:})} 0x9F4D96E3D7D02AAE5797A4AEC19F938F: {(op (if (eval (at >>message 1) >>sender) (eval (to-record (concat [do] (rest (rest >>message)))) >>sender))) (doc {see: [unless if cond] usage: "(when TEST FORM …)" summary: "Each FORM in turn when TEST isn't nil, answering the last, and nil otherwise."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0xA06CD045BA7F849ABF07AA4B73CAEF41: {(doc "(do FORM …)\nEach form in turn, answering the last, or nil when there is none.") (native do)} 0xA4F67F3B300EF0D15007645B86E423ED: {(doc "(id ID)\nThe object in the image with that id.") (native id)} 0xAAA5C07D371BAA04FF454A4D0B1C7829: {(fn [items f] (def i 0) (while (lt i (len items)) (f (at items i)) (set i (add i 1))) items) (doc {see: [map filter while] usage: "(each ITEMS F)" summary: "F called with each member of ITEMS in turn, answering ITEMS."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0xABBE57D0748C665701A5FC3F9BEAABBE: {(doc "(keys X)\nA list of a dict's keys or a set's members, in CE order.") (native keys)} 0xB00CDB120073EF7771E0FA195FED5714: {(op (def name (at >>message 1)) (def forms (rest (rest >>message))) (def doc nil) (when (eq (kind (first forms)) (quote text)) (set doc (first forms)) (set forms (rest forms))) (def made (eval (to-record (concat [fn] forms)) >>sender)) (when doc (set (layer made doc) (record (quote doc) doc))) (eval (record (quote def) name (record (quote quote) made)) >>sender) made) (doc {see: [fn def document] usage: "(defn NAME DOC? [PARAM …] FORM …)" summary: "NAME, in this scope, now holds a function, carrying DOC when there is one."}) (slots {>>parent: (object 0x586490BD8CF624272FBF2D8D41EE7083)})} 0xB1EF6F60D8378E77DFB935DE6C955036: {(doc "(slots OBJ)\nA list of the names of OBJ's own slots.") (native slots)} 0xB4850FE0A0D337912389F76007FDF2E5: {(doc "(ge A B)\nA when it comes after B or equals it, and nil otherwise.") (native ge)} 0xB665C957FDEDDEF285CDA534938C605A: {(doc {see: [trace id id-of describe] body: "An object gets an id when it enters the image, by being put into an\nobject already there. What happens to the image is said as events:\n(created ID FORMS), (defined ID NAME NEW), (changed ID NAME OLD NEW),\n(removed ID NAME OLD), (layered ID FORM) and (unlayered ID FORM). A\nhistory keeps them as a log, a saved image is a snapshot of the root, and\nloading reads the snapshot and then the log after it. (trace on) prints\neach message as it is sent." usage: "the image and its history" summary: "Everything reachable from the root is the image, and each change to it is said as an event."}) (slots {:})} 0xB810E9DA96CBBD259A1A25D48399210A: {(doc "(list X …)\nA list of the values.") (native list)} 0xBF56B8224407D3424601E89D0B284D10: {(doc "(join LIST SEP?)\nThe members of LIST as text, with SEP between them.") (native join)} 0xBF7B10F51BE09B4D3CB19B4689656613: {(doc "(set REF EXPR)\nThe place REF names now holds what EXPR evaluates to.") (native set)} 0xC097C29F25D4FC211E2F14FCAA22390D: {(doc "(trace on), (trace off), (trace FORM)\nPrints each message sent, as (sent MSG TO), while on, or while FORM is\nevaluated, answering its value.") (native trace)} 0xC895B13C21AF07C7A36AE38E6639FCAB: {(doc "(has X MEMBER)\nMEMBER when X holds it, and nil otherwise: a dict's key, a set's\nmember, a list's or record's member, a text within a text.") (native has)} 0xC90ED9D6CB8076C25BEBCB1FA05DA245: {(doc "(run-file PATH)\nEach value in the file at PATH evaluated here, answering the last.") (native run-file)} 0xDCEFEF0AACA36CC7568C16747060CD06: {(doc "(eval EXPR SCOPE?)\nWhat EXPR evaluates to, evaluated again in SCOPE, or here.") (native eval)} 0xDF3C32048198D296BE723B587DCE6BAF: {(doc {see: [set get ref at slot inc] body: "(set REF EXPR) puts into the place REF names and (get REF) reads it.\nPlaces nest: (set (at (at m (quote a)) 1) 9) builds the inner list anew,\nthen the dict holding it, and puts the dict back where m is. (ref REF)\nanswers the place itself, an object to pass around. An object of your own\nis a place when it answers (>>get) and (>>put V). inc and dec take any\nreference." usage: "places and generalized 