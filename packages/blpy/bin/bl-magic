#!/usr/bin/env python3
"""bl magic, run from this checkout: format conversion through values."""
import os
import sys

if sys.version_info < (3, 11):
    sys.exit(f"bl-magic needs Python 3.11 or later; {sys.executable} is {sys.version.split()[0]}")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from bassline.magic import main  # noqa: E402

sys.exit(main())
