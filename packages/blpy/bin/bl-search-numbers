#!/usr/bin/env python3
"""bl search numbers, run from this checkout: the numbers lever as a filter over CE."""
import os
import sys

if sys.version_info < (3, 11):
    sys.exit(f"bl-search-numbers needs Python 3.11 or later; {sys.executable} is {sys.version.split()[0]}")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from bassline.levers import main  # noqa: E402

sys.exit(main("numbers"))
