{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "bassline",
  "scopeName": "source.bassline",
  "patterns": [{ "include": "#value" }],
  "repository": {
    "value": {
      "patterns": [
        { "include": "#actionable" },
        { "include": "#string" },
        { "include": "#quoted-symbol" },
        { "include": "#bytes" },
        { "include": "#number" },
        { "include": "#constant" },
        { "include": "#punctuation" },
        { "include": "#symbol" }
      ]
    },

    "actionable": {
      "name": "keyword.operator.actionable.bassline",
      "match": "`"
    },

    "string": {
      "name": "string.quoted.double.bassline",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.bassline" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.bassline" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.bassline",
          "match": "\\\\([\"\\\\ntr])"
        }
      ]
    },

    "quoted-symbol": {
      "name": "entity.name.symbol.bassline",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.symbol.begin.bassline" }
      },
      "end": "'",
      "endCaptures": {
        "0": { "name": "punctuation.definition.symbol.end.bassline" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.bassline",
          "match": "\\\\(['\\\\ntr])"
        }
      ]
    },

    "bytes": {
      "name": "meta.bytes.bassline",
      "begin": "#\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.bytes.begin.bassline" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bytes.end.bassline" }
      },
      "patterns": [
        { "name": "constant.numeric.hex.bassline", "match": "[0-9A-Fa-f]+" }
      ]
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.bassline",
          "match": "(?<![^\\s\\[\\]{}():#'\"`])(NaN|-?Infinity)(?=[\\s\\[\\]{}():#'\"`]|$)"
        },
        {
          "name": "constant.numeric.float.bassline",
          "match": "(?<![^\\s\\[\\]{}():#'\"`])[+-]?(\\d+\\.\\d+([eE][+-]?\\d+)?|\\d+[eE][+-]?\\d+)(?=[\\s\\[\\]{}():#'\"`]|$)"
        },
        {
          "name": "constant.numeric.integer.bassline",
          "match": "(?<![^\\s\\[\\]{}():#'\"`])[+-]?\\d+(?=[\\s\\[\\]{}():#'\"`]|$)"
        }
      ]
    },

    "constant": {
      "name": "constant.language.bassline",
      "match": "(?<![^\\s\\[\\]{}():#'\"`])(nil|true|false)(?=[\\s\\[\\]{}():#'\"`]|$)"
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.bassline",
          "match": "#\\{|[\\[\\]{}()]"
        },
        { "name": "punctuation.separator.key-value.bassline", "match": ":" }
      ]
    },

    "symbol": {
      "name": "entity.name.symbol.bassline",
      "match": "[^\\s\\[\\]{},():#'\"`]+"
    }
  }
}
