{
  "name": "bassline-text",
  "displayName": "bassline-text",
  "description": "Vscode support for the bassline text format",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bassline-text",
        "aliases": [
          "bassline",
          "bassline-text"
        ],
        "extensions": [
          ".blt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bassline-text",
        "scopeName": "source.bassline",
        "path": "./syntaxes/bassline-text.tmLanguage.json"
      }
    ]
  }
}
