{
  "name": "bassline-text",
  "displayName": "Bassline",
  "description": "VS Code support for the bassline text syntax (.bl)",
  "version": "0.1.0",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:bassline"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bassline",
        "aliases": [
          "Bassline",
          "bassline"
        ],
        "extensions": [
          ".bl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bassline",
        "scopeName": "source.bassline",
        "path": "./syntaxes/bassline.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bassline/core": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  }
}
