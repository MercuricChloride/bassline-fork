<document
    `{ author: goose }
    `<def-custom greeting "Hello">
    `<def-custom mood "excited">
    `<def-custom pick "one">
    <stack
        <heading `{level: 2} "Live bindings">

        <text "Two custom bindings are declared at the top of this document. The
               panel below is generated by enumerating them — the document never
               names these controls. Editing a field, or pressing a button, updates
               the single binding namespace, and every reference re-renders.">

        <settings>

        <text "Greeting is now: " `greeting>

        <row
            <button `{on-click: `<set greeting "Hi">} "Hi">
            <button `{on-click: `<set greeting "Hey">} "Hey">
        >

        <dropdown `{bind: pick}
            <label "Pick one">
            <option "one">
            <option "two">
            <option "three">>

        <text "You picked: " `pick>
    >
>
