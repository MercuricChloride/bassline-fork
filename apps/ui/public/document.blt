<document
    `{
        theme: { bg: white  text: black }
        author: goose
        email: "goose@example.com"
        date: "2024-06-14"
        id: "my-document"
    }
    <stack
        <text "This is some text with a link: "
            <link `{href: "https://example.com"} "example ">
            "and some more text">

        <dropdown
            <label "select an option">
            <option "option 1">
            <option "option 2">>
        
        <button "click me">

        <block
            `{language: "forth" name: "addition"}
            "10 20 +"
            `{results: 30}
        >

        <block
            `{language: "python"}
            "print('hello, world')">
    >
>